# Скопируй в .env.sh (в git не попадает: .gitignore .env.*) и подставь
# реальный адрес relay. scripts/build-linux.sh подхватывает его сам, если
# файл есть -- KOPT_RELAY_DEFAULT уходит в -DKOPT_RELAY_DEFAULT=... на
# cmake configure и запекается в kopt_payload как дефолт (см. CMakeLists.txt
# и config.hpp::KOPT_DEFAULT_SHARE_ENDPOINT). Без .env.sh используется
# плейсхолдер 127.0.0.1:8443 -- собирается и работает, просто указывает
# в никуда, пока не переопределён через ini/--backend в рантайме.
export KOPT_RELAY_DEFAULT="host:port"
