<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kopt.Loader.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
            <Setter Property="Background" Value="#09070D" />
            <Setter Property="Foreground" Value="#F4F0FA" />
        </Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9C93A9" /></Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#A78BFA" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#120E1A" />
            <Setter Property="BorderBrush" Value="#2A2037" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#8B5CF6" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="#9D78FF" /></Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BDB4C9" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#1D1628" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0E0B14" />
            <Setter Property="BorderBrush" Value="#342842" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Application.Styles>
</Application>
